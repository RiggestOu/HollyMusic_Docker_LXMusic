# ============================================================================
# 只影响 Git 跟踪范围，不会删除任何本地文件
# 目标：依赖 / 构建产物 / 生成代码 / 本地数据 / 密钥 一律不进仓库，
#       保证 GitHub Actions 每次都在干净源码上重新构建（Docker 镜像 + Windows 客户端）
# ============================================================================

# ---------- 依赖 ----------
node_modules/
frontend/node_modules/
.pnpm-store/

# ---------- 构建产物 ----------
dist/
out/
build/
.next/
frontend/dist/
# tsc -b 产生的增量构建信息
*.tsbuildinfo

# ---------- Tauri 桌面端 ----------
# target/ 与 gen/ 是构建产物（数百 MB），不上传；
# dist/ 是 tauri.conf.json 里 frontendDist 必需的占位页，必须保留（因此在上面 dist/ 规则后取反）。
src-tauri/target/
src-tauri/gen/
!src-tauri/dist/

# ---------- 生成代码（构建期重新生成，不要进仓库）----------
# Dockerfile 的 frontend-builder 阶段会执行 `pnpm prisma generate`
lib/generated/

# ---------- 本地运行数据 / 数据库（用户数据，绝不上传）----------
data/
prisma_data/
prisma/*.db
prisma/*.db-journal
*.sqlite
*.sqlite-journal
*.db
*.db-journal

# ---------- 环境变量与密钥 ----------
.env
.env.*
!.env.example

# ---------- 日志 ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 缓存 / 覆盖率 ----------
# 注意：不要写裸 cache/ —— 仓库里有源码目录 app/api/admin/cache/
.cache/
.turbo/
coverage/
.nyc_output/

# ---------- IDE / 编辑器 ----------
.vscode/
.idea/
*.swp
*.swo
*.swox

# ---------- 系统文件 ----------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini

# ---------- 本地工作区（WorkBuddy 记忆等，仅本机）----------
.workbuddy/
