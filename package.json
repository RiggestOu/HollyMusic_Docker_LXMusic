{
  "name": "holly-mudic",
  "version": "1.0.0",
  "description": "Docker-based music player with LX Music source loading logic",
  "main": "src/main/server.js",
  "scripts": {
    "start": "node src/main/server.js",
    "dev": "node src/main/server.js",
    "build": "echo 'Build completed'",
    "docker:build": "docker build -t holly-mudic:latest .",
    "docker:run": "docker run -d -p 3080:3080 -v $(pwd)/data:/data/config holly-mudic:latest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "author": "HollyMudic",
  "license": "Apache-2.0"
}
